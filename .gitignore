# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env.*
!.env.example

# typescript
*.tsbuildinfo

# Claude Code local / runtime artifacts (keep shared config like settings.json versionable)
.claude/scheduled_tasks.lock
.claude/settings.local.json

# generated native folders
/ios
/android

# Supabase CLI local link state (machine-specific, not for VCS)
supabase/.temp/
supabase/.branches/

# Store-submission signing secrets (prefer storing these on EAS servers instead).
# Never commit: App Store Connect API key (.p8) or Google Play service-account JSON.
/credentials/
*.p8
*-service-account*.json
google-play-*.json
fastlane/report.xml
