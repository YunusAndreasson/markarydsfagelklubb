    "@expo/agent-cli": "^1.0.23",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3",
    "vitest": "^4.1.12"
