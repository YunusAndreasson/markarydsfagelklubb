{
  "name": "mafk-mobie",
  "main": "expo-router/entry",
  "version": "1.1.1",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "bash ./scripts/dev-android.sh",
    "android:plain": "expo run:android",
    "ios": "expo run:ios",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "deps:check": "bash ./scripts/update-deps.sh",
