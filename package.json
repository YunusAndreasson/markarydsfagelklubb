{
  "name": "mafk-mobie",
  "main": "expo-router/entry",
  "version": "1.0.1",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "bash ./scripts/dev-android.sh",
    "android:plain": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "deps:check": "bash ./scripts/update-deps.sh",
    "deps:update": "bash ./scripts/update-deps.sh --apply",
    "deps:update:latest": "bash ./scripts/update-deps.sh --apply --latest",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "release": "./scripts/release.sh all",
    "release:check": "./scripts/release.sh --check all",
    "release:ios": "./scripts/release.sh ios",
    "release:android": "./scripts/release.sh android",
    "release:all": "./scripts/release.sh all"
  },
  "dependencies": {
    "@expo/ui": "~57.0.7",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@supabase/supabase-js": "^2.107.0",
    "@tanstack/query-sync-storage-persister": "^5.101.0",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-query-persist-client": "^5.101.0",
    "expo": "^57.0.0",
    "expo-apple-authentication": "~57.0.1",
    "expo-application": "~57.0.2",
    "expo-build-properties": "~57.0.6",
    "expo-constants": "~57.0.6",
    "expo-crypto": "~57.0.1",
