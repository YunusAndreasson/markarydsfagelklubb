    "deps:update:latest": "bash ./scripts/update-deps.sh --apply --latest",
    "test": "vitest run",
    "api:check": "node ./scripts/check-deprecated-apis.mjs",
    "verify": "npm run typecheck && npm run lint && npm run api:check && npm run test",
    "release": "./scripts/release.sh all",
    "release:check": "./scripts/release.sh --check all",
    "release:ios": "./scripts/release.sh ios",
    "release:android": "./scripts/release.sh android",
    "release:all": "./scripts/release.sh all"
  },
  "dependencies": {
