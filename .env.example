# Shared mafk Supabase project (same backend as the web app). The publishable
# key (sb_publishable_*) ships in the client; RLS is the real boundary (M4).
# Real client wiring lands in M3 — fill the key in your local .env then.
EXPO_PUBLIC_SUPABASE_URL=https://zgnmajovyqibgxlcomvb.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Web OAuth client id from Google Cloud project mafk-498611 (APIs & Services >
# Credentials > "mafk web (Supabase)"). Required for native Google sign-in:
# the google-signin lib requests an ID token for this client, and Supabase
# verifies the token's audience against it. Also set in the EAS environments
# (eas env:list). Without it, signInWithGoogle fails immediately (use-auth.tsx).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=700238607781-i1t9kfv0un9b2o0aro9qv3bee8cqki0t.apps.googleusercontent.com
